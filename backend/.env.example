# Copy to .env and adjust.

# Secret used to sign JWT tokens — set a long random value in production!
SECRET_KEY=change-me-in-production

# SQLite is used by default. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://navbat:navbat@localhost:5432/navbat
# DATABASE_URL=sqlite+aiosqlite:///./data/navbat.db

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma/JSON list of allowed frontend origins for CORS (dev server)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Set to 0 to disable all Telegram bots (e.g. in CI)
TELEGRAM_ENABLED=1

# Minutes a called client has to reach the desk (countdown on the display)
CALL_TIMEOUT_MINUTES=3
