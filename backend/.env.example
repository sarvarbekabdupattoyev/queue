# Copy to .env and adjust.

# Secret used to sign JWT tokens and webhook secrets — set a long random value!
SECRET_KEY=change-me-in-production

# --- Databases -------------------------------------------------------------
# SQLite (default) is fine for local development only — single writer.
# Production: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://navbat:navbat@localhost:5432/navbat
# DATABASE_URL=sqlite+aiosqlite:///./data/navbat.db

# Per-worker connection pool (Postgres). Total = workers × (size + overflow).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (multi-process switch) ------------------------------------------
# Empty → single-process dev mode: one uvicorn worker embeds the bots and
#          keeps WS rooms in memory.
# Set   → production mode: run the API with --workers N plus the separate
#          bot service (uvicorn app.bot_main:app). Redis carries WS pub/sub,
#          Telegram notifications and bot FSM state.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Telegram ---------------------------------------------------------------
# Master switch (0 in CI/tests).
TELEGRAM_ENABLED=1
# Webhook mode for the bot service: public HTTPS base routed to it,
# e.g. https://example.com/tgwh (nginx proxies /tgwh/ → bot:8081).
# Empty → long polling (works without a public URL).
BOT_WEBHOOK_BASE=
# Concurrent update processing in the bot service (protects the DB pool
# during 1000–2000-registration bursts).
BOT_MAX_CONCURRENT_UPDATES=64

# --- App --------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Screens receive at most one state rebuild per window, whatever the load.
BROADCAST_DEBOUNCE_MS=200
# Minutes a called client has to reach the desk (countdown on the display).
CALL_TIMEOUT_MINUTES=3
