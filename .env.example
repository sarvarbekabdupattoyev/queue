# SmartNavbat — production environment (cp .env.example .env, then fill in).
# Secrets live ONLY here; .env is gitignored. Never commit real values.

# --- required secrets -------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- service sizing (8 vCPU node) -------------------------------------------
API_WORKERS=4
# DB connections: api = API_WORKERS x (pool + overflow), bot = pool + overflow.
# 4 x (10+10) + (10+10) = 100 — comfortably under Postgres max_connections=200.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Telegram ---------------------------------------------------------------
TELEGRAM_ENABLED=1
# Webhook mode (recommended for sale-day bursts). Leave empty for long polling.
# Each company bot registers at {base}/{bot_id} with a per-bot HMAC secret.
BOT_WEBHOOK_BASE=https://smartnavbat.uz/tgwh
# Updates processed concurrently by the bot service. Far above the bot's DB
# pool on purpose: Telegram is already ACKed; excess handlers queue on the
# pool instead of on Telegram's side.
BOT_MAX_CONCURRENT_UPDATES=300

# --- product ----------------------------------------------------------------
# Minutes a called client has to reach the desk.
CALL_TIMEOUT_MINUTES=3
